# PRISM tracing (observability for the agent graph)
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app

# LLM provider. Optional: when unset the pipeline runs a deterministic
# stub extractor so the graph is demoable without provider credentials.
ANTHROPIC_API_KEY=

# Optional: web search (Tavily). Unset -> code paths that use it degrade gracefully.
TAVILY_API_KEY=

# Optional: serverless Qwen reasoning model on Modal (see modal_app/qwen_reasoner.py).
# Takes priority over ANTHROPIC_API_KEY when set.
MODAL_QWEN_URL=
MODAL_KEY=
MODAL_SECRET=

LEDGER_DB=data/ledger.db
